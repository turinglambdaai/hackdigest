{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HackDigest",
  "version": "0.1.1",
  "identifier": "site.jrtx.hackdigest",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HackDigest",
        "width": 1160,
        "height": 800,
        "minWidth": 820,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/turinglambdaai/hackdigest/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENkUwOUNFMzkyOUMwODkKUldTSndDazV6Z2x1VFFHSVhTUWJ6YmxlQXY2d2UwVStiRkpNL1J2dTJUcVVYM3lkTU5jb2ZYS1kK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "News",
    "shortDescription": "Hacker News, in your language",
    "longDescription": "A Hacker News reader for non-English readers — built-in translation and AI digests. Bring your own LLM key, everything is free.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
